<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Forgekit.Core\Forgekit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>forgekit</AssemblyName>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>forgekit</ToolCommandName>
    <PackageId>MiradorWorks.Forgekit</PackageId>
    <Version>0.1.0-rc.1</Version>
    
    <Authors>Gonzalo Blanch Domínguez (MiradorWorks)</Authors>
    <Description>CLI toolkit for game development. Audits Unity projects for orphan assets, unoptimized textures and duplicate files, and can fail a CI pipeline.</Description>
    <PackageTags>unity;gamedev;cli;assets;audit;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Goblanch/forgekit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Goblanch/forgekit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
